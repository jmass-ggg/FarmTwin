# FarmTwin Backend Configuration - Example
# Copy this file to .env and configure with actual values
# NEVER commit .env with real credentials

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Values: development, staging, production
ENVIRONMENT=development

# Values: live, historical_replay, demonstration
DATA_MODE=live

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Values: oidc, local_demo
AUTH__MODE=local_demo

# Required for oidc mode (example values shown)
# AUTH__ISSUER=https://your-identity-provider.example.com
# AUTH__AUDIENCE=farmtwin-api
# AUTH__JWKS_URL=https://your-identity-provider.example.com/.well-known/jwks.json
# AUTH__ALGORITHMS=["RS256"]

# ============================================================================
# DATABASE - Main
# ============================================================================
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=farmtwin
DATABASE__USER=farmtwin_runtime
DATABASE__PASSWORD=runtime_dev_password

# Connection pool settings
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT_SECONDS=1
DATABASE__CONNECT_TIMEOUT_SECONDS=1
DATABASE__STATEMENT_TIMEOUT_MS=1000

# ============================================================================
# DATABASE - Migration Role (for alembic commands)
# ============================================================================
# Use these credentials ONLY for running migrations
# MIGRATION__DATABASE__USER=farmtwin_admin
# MIGRATION__DATABASE__PASSWORD=admin_dev_password

# ============================================================================
# LOCAL DEVELOPMENT AUTHENTICATION
# ============================================================================
# Both must be true for local_demo authentication mode
DEMO__LOCAL_ONLY=true
DEMO__ISOLATED_DATABASE=true

# When using local authentication, point to the isolated development database:
# DATABASE__NAME=farmtwin_demo
# DATABASE__PORT=5433

# ============================================================================
# CORS
# ============================================================================
# JSON array of exact allowed origins
# Empty array = no browser access
CORS__ORIGINS=["http://localhost:3000"]

# Reverse proxies allowed to supply X-Forwarded-For/X-Forwarded-Proto.
# Keep empty for direct/local serving. Use exact IPs or canonical CIDRs; never "*".
# Uvicorn must be launched with --no-proxy-headers because the application owns
# this trust decision.
PROXY__TRUSTED_IPS=[]

# ============================================================================
# LOGGING
# ============================================================================
# Values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# API BINDING (for local demo)
# ============================================================================
# Bind to loopback only for local demo
API_HOST=127.0.0.1
API_PORT=8000
